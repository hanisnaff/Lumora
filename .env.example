# Optional overrides; Lumora has safe public defaults for its connected Supabase project.
# Publishable keys are designed for browser use. Never place a service-role/secret key in VITE_*.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional server-side overrides for the Vercel API functions.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
